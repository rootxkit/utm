# Staging server environment (P0-09). Copied to infra/deploy/.env on the
# server by infra/deploy/make_env.sh, which fills every CHANGE_ME with a
# fresh random value. Never committed: .env is gitignored.

COURIER_ENV=staging
LOG_LEVEL=INFO

UTM_HOST=utm.chikox.net
INGEST_HOST=ingest.chikox.net

POSTGRES_USER=courier
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=courier
DATABASE_URL=postgresql+asyncpg://courier:${POSTGRES_PASSWORD}@postgres:5432/courier

TIMESCALE_USER=courier
TIMESCALE_PASSWORD=CHANGE_ME
TIMESCALE_DB=courier_telemetry
TELEMETRY_DATABASE_URL=postgresql+asyncpg://courier:${TIMESCALE_PASSWORD}@timescale:5432/courier_telemetry
TELEMETRY_RETENTION_DAYS=90
ARCHIVE_ROOT=/data/archive
ARCHIVE_MAX_GIB_PER_STATION=10

REDIS_URL=redis://redis:6379/0
NATS_URL=nats://nats:4222

# The Gateway's direct MAVLink listener is for a laptop next to a SITL; on
# the server, stations deliver over relay-v1 (ingest host) only, and this
# port is not published.
MAVLINK_BIND_HOST=0.0.0.0
MAVLINK_BIND_PORT=14445

FEED_TICKET_SECRET=CHANGE_ME
COOKIE_SECURE=true
CONSOLE_FEED_URL=/ws/telemetry

TERRAIN_DIR=/data/terrain
BASEMAP_DIR=/data/basemap
GEOID_PATH=/data/geoid/egm2008-2_5.pgm
