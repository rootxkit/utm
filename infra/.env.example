# Copy to .env at the repository root:  cp infra/.env.example .env
#
# Development defaults only. Never commit a real .env — it is gitignored.
# Every variable here is read through common/ (P0-07); no service reads
# os.environ directly.

# --- Environment ------------------------------------------------------------
COURIER_ENV=dev
LOG_LEVEL=INFO

# --- PostgreSQL + PostGIS (registry, airspace zones, audit log) -------------
POSTGRES_USER=courier
POSTGRES_PASSWORD=courier_dev
POSTGRES_DB=courier
# If a native PostgreSQL already listens on 5432 (a Windows install does by
# default), localhost:5432 reaches it instead of this stack and every login
# fails. Move this port, and DATABASE_URL with it.
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://courier:courier_dev@localhost:5432/courier

# --- TimescaleDB (drone_state hypertable) -----------------------------------
TIMESCALE_USER=courier
TIMESCALE_PASSWORD=courier_dev
TIMESCALE_DB=courier_telemetry
TIMESCALE_PORT=5433
TELEMETRY_DATABASE_URL=postgresql+asyncpg://courier:courier_dev@localhost:5433/courier_telemetry
# Governs BOTH drone_state retention (P1-04) and the Gateway's raw archive.
# One setting on purpose: the archive must not outlive the telemetry it
# explains, nor the telemetry the archive. Do not add a second variable.
TELEMETRY_RETENTION_DAYS=90
# Per-station ceiling on the raw archive, in gigabytes. Reached before the
# retention period expires, the oldest whole segments are deleted first and
# each deletion is recorded in ingest_events - the Gateway has nobody
# downstream to report a drop to, so that row is the entire audit trail.
ARCHIVE_MAX_GIB_PER_STATION=250
# Server-side archive root. Not a pilot's laptop: that disk is protected by the
# relay's own queue cap (P7-11), which is a different mechanism, same principle.
ARCHIVE_ROOT=./.archive

# --- Redis (live drone state) -----------------------------------------------
REDIS_PORT=6379
REDIS_MAXMEMORY=256mb
REDIS_URL=redis://localhost:6379/0

# --- NATS (internal pub/sub) ------------------------------------------------
NATS_PORT=4222
NATS_MONITOR_PORT=8222
NATS_URL=nats://localhost:4222

# --- Gateway (P1-02) --------------------------------------------------------
# UDP socket the MAVLink stream arrives on.
MAVLINK_BIND_HOST=0.0.0.0
MAVLINK_BIND_PORT=14445
# A vehicle not refreshed within this window counts as link-lost; matches the
# Redis TTL in ARCHITECTURE.md §1.
LINK_TIMEOUT_S=15

# drone_state is inserted every STATE_FLUSH_ROWS rows or STATE_FLUSH_INTERVAL_S
# after the first buffered row, whichever comes first (P1-04). The console is
# fed from the bus, so this delays only the hypertable.
STATE_FLUSH_ROWS=100
STATE_FLUSH_INTERVAL_S=0.5

# --- Agent / ground relay (P1-01) -------------------------------------------
# The relay is NOT configured here. It runs on a pilot's laptop and is
# configured from TOML, which a pilot can open and read: see
# agent/relay.example.toml. Its bearer token lives in a separate file again,
# so a configuration can be shared without leaking a credential.

# P1-12: the console's self-hosted base map, fetched once per machine with
# infra/basemap/fetch_basemap.sh. Relative to where the console is started.
BASEMAP_DIR=local/basemap

# P10-03: flight replay, served by the API (see docs/runbooks/p10-03-replay.md).
# Samples further apart than the threshold are a hole, never joined by a line.
REPLAY_GAP_THRESHOLD_S=3.0
REPLAY_EVIDENCE_SLACK_S=5.0
REPLAY_FLIGHT_SPLIT_S=120.0
REPLAY_MAX_SAMPLES=100000

# P6-08: operator sign-in. The API signs console-feed tickets with this
# secret and the console checks them with it, so both must see the same
# value. At least 32 characters; a value starting "dev-only-" is refused
# outside COURIER_ENV=dev. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
FEED_TICKET_SECRET=dev-only-0000000000000000000000000000000000
FEED_TICKET_TTL_S=600
SESSION_TTL_S=43200
SESSION_IDLE_TIMEOUT_S=3600
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_S=900
# Plain HTTP on this machine only. Must be true behind TLS (P0-09).
COOKIE_SECURE=false
# Where the browser reaches the console feed from the API's /map page.
CONSOLE_FEED_URL=ws://127.0.0.1:8000/ws/telemetry
# P6-01: the built operator console, served by the API at /app.
CONSOLE_APP_DIR=web-pilot/dist
# P5-00: terrain tiles (tools/terrain_fetch.py), read by the API and by the
# airspace monitor (P5-19 height limit). Unset: no height above ground.
# TERRAIN_DIR=local/terrain

# --- Remote ID ingest (P1-15) ---------------------------------------------------
# Receivers send datagrams here. Without receiver keys the ingest refuses to
# bind anywhere but loopback: anything reaching the port could add aircraft.
REMOTE_ID_BIND_HOST=127.0.0.1
REMOTE_ID_BIND_PORT=14600
# Signed receivers (python -m tools.remote_id_keys new <receiver> --file ...).
# REMOTE_ID_RECEIVER_KEYS=local/remote-id-receivers.keys
# REMOTE_ID_MAX_SKEW_S=30
# The geoid grid (infra/geoid/fetch_geoid.sh; EGM2008, the terrain's datum).
# Without it, Remote ID
# aircraft have no AMSL altitude and are not evaluated for conflicts.
# GEOID_PATH=local/geoid/egm2008-2_5.pgm

# U-03: the most positions one ring of a zone may have (5000 by default).
# Also the geoid above is read by the airspace monitor, for zone limits given
# above the WGS-84 ellipsoid.
# ZONE_MAX_RING_VERTICES=5000

# U-01: the shape of a UAS operator registration number, matched against the
# whole value. Georgia's format is not confirmed; this is the loose EU shape
# (a three-letter country code, then letters and digits).
UAS_OPERATOR_REGISTRATION_PATTERN=^[A-Z]{3}[A-Za-z0-9]{8,16}$
