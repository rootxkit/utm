# Secrets and local configuration
.env
.env.*
!.env.example
sim/sitl.env
!sim/sitl.env.example

# Ground relay: the bearer token lives in its own file so a configuration can
# be shared without it. Never commit one.
*.token
relay.toml
!relay.example.toml

# Local scratch area for hands-on testing: configs, tokens, queues, logs.
# Nothing here belongs in the repository; the test RECORD goes in docs/.
local/

# P1-01 hardware test artifacts: the development CA, the server certificate
# it signs, and whatever the sink received. Keys especially - the dev CA can
# sign anything the relay would then trust.
relay-test/
sink-data/
*.crt
*.key
*.csr
*.srl

# Ground relay durable queue (SQLite, plus its WAL sidecars)
relay-queue.sqlite3
*.sqlite3-wal
*.sqlite3-shm

# Flight and telemetry artifacts
*.bin
*.BIN
*.tlog
*.tlog.raw
*.log
logs/

# SITL / ArduPilot artifacts
sim/out/
sim/logs/
eeprom.bin
mav.parm
terrain/
ArduCopter.elf
*.parm.bak

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Node
node_modules/
.pnpm-store/
web-pilot/dist/
web-pilot/.vite/
# Generated from web-pilot/openapi.json at build time; never hand-written.
web-pilot/src/api/schema.d.ts

# Editors and OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Local per-developer tool overrides
.claude/settings.local.json

# P0-09: staging server secrets and data, never committed.
infra/deploy/secrets/
infra/deploy/data/
