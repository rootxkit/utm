{
  "name": "courier-web-pilot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Operator console: live map, aircraft, alerts, stations. P6-01.",
  "scripts": {
    "gen:api": "openapi-typescript openapi.json -o src/api/schema.d.ts",
    "typecheck": "npm run gen:api && tsc --noEmit -p .",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "build": "npm run gen:api && tsc --noEmit -p . && vite build",
    "test": "vitest run",
    "dev": "vite"
  },
  "dependencies": {
    "@protomaps/basemaps": "^5.7.0",
    "maplibre-gl": "^5.6.0",
    "pmtiles": "^4.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "eslint": "^9.28.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "openapi-typescript": "^7.8.0",
    "prettier": "^3.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.34.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.7"
  }
}
